# Product unit: automatic LSCache cleanup (docs/product-interfaces.md, "LSCache management"). OLS leaves an expired cache entry on
# disk until the same URL is cached again, so the stores of sites with many URLs would grow without bound. This pass removes expired
# entries, keeps every store under its size cap and the server under its cap, and trims harder when the disk is nearly full. The
# deletions are done by an unprivileged helper (the store's owner, no capabilities), never by root itself. Run by
# ols-cpanel-cache-clean.timer; enabled by `install --prepare` and by `upgrade`, never started by the package.
[Unit]
Description=OLS-cPanel LSCache cleanup
After=local-fs.target
ConditionPathExists=/usr/local/ols-cpanel/bin/ols-cpanel

[Service]
Type=oneshot
# Root: it reads the stores' owners and starts the helper as that user (setpriv); the limits and the state are root-owned files.
ExecStart=/usr/local/ols-cpanel/bin/ols-cpanel cache clean --format=json
TimeoutStartSec=3600
# Background work: it must never compete with the web server for the disk.
Nice=19
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/ols-cpanel
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
