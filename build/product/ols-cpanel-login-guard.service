# Product unit: the WordPress login guard (RV-64, CMP-04; docs/product-interfaces.md, "Login guard"). `ols-cpanel login-guard run`
# reads the new lines of cPanel's domlogs every five seconds, blocks an address that floods a site's wp-login.php or xmlrpc.php
# (more than 20 or 30 POSTs a minute) for that site, and writes the blocks to /run/ols-cpanel/guard/login.map, which every tenant
# vhost's rewrite rule reads (403 before PHP; OLS re-reads the changed map by itself, no reload). Blocks expire. On by default;
# the WHM switch (`login-guard set --enabled=no`) empties the map. Enabled by `install --prepare` and by `upgrade`, never started
# by the package.
[Unit]
Description=OLS-cPanel WordPress login guard
After=local-fs.target ols-cpanel-logs.service
ConditionPathExists=/usr/local/ols-cpanel/bin/ols-cpanel
StartLimitIntervalSec=0

[Service]
Type=simple
# Root: cPanel's domlogs are root-only, and the map is root:nobody 0640 (the OLS workers read it, tenants' PHP cannot).
ExecStart=/usr/local/ols-cpanel/bin/ols-cpanel login-guard run
Restart=always
RestartSec=5
# Default CPU share and priority: it must keep up while a flood saturates the server.
UMask=0077
NoNewPrivileges=yes
# full, not strict: /run/ols-cpanel only appears when OLS takes over (ols-cpanel-logs.service), after this service started.
ProtectSystem=full
ReadWritePaths=/var/lib/ols-cpanel
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# No network: the server's own addresses come from /proc/net (which a private network namespace would hide).
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
