# Product unit: periodic PHP environment pass (the fallback for changes the package-transaction watcher cannot see, and
# the retry clock for failed versions: their own back-off decides when each is tried again). Enabled by
# `ols-cpanel install --prepare`, the PHP environment pass and `ols-cpanel php opcache install`, never by the package.
[Unit]
Description=OLS-cPanel PHP environment timer

[Timer]
OnBootSec=180
# Every 5 minutes (RV-62): a PHP worker limit raised by demand reaches the running lsphp at the next pass; one pass
# costs about 1 s of CPU.
OnUnitActiveSec=300
AccuracySec=30s

[Install]
WantedBy=timers.target
