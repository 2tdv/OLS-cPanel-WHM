#!/bin/sh
# Graceful OLS restart that systemd can follow (ExecReload of ols-cpanel.service).
# On SIGUSR1 the OLS main process removes its PID file, forks, and a freshly executed instance writes
# a new PID file; the old main exits after draining. systemd re-reads PIDFile= when ExecReload
# finishes, so this waits until the new main process is ready: otherwise the old main's exit ends
# the unit and takes the new instance down with it.
# "Ready" means the main process has forked its workers. OLS writes the PID file before loading
# its configuration and installs its signal handlers only afterwards; a SIGUSR1 in that window
# terminates the server (OLS patch 0007 also guards against it).
PIDFILE=/run/ols-cpanel/lshttpd/lshttpd.pid

ready() {
    kill -0 "$1" 2>/dev/null && /usr/bin/pgrep -P "$1" -f 'lshttpd - #' >/dev/null
}

wait_ready() {  # $1: PID to wait for, or "new:<old>" for a main process other than <old>
    i=0
    while [ "$i" -lt 600 ]; do
        pid=$(cat "$PIDFILE" 2>/dev/null)
        case "$pid" in
            ''|*[!0-9]*) ;;
            *) case "$1" in
                   new:"$pid") ;;
                   new:*) ready "$pid" && return 0 ;;
                   "$pid") ready "$pid" && return 0 ;;
               esac ;;
        esac
        sleep 0.1
        i=$((i + 1))
    done
    return 1
}

old=$(cat "$PIDFILE" 2>/dev/null)
case "$old" in ''|*[!0-9]*) echo "ols-cpanel-reload: no running main process" >&2; exit 1 ;; esac
wait_ready "$old" || { echo "ols-cpanel-reload: main process $old is not ready" >&2; exit 1; }
kill -USR1 "$old" || exit 1
wait_ready "new:$old" && exit 0
echo "ols-cpanel-reload: no ready main process after 60 s" >&2
exit 1
