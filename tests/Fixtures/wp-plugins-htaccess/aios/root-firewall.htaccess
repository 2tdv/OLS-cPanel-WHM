#AIOWPSEC_BEGIN_FIREWALL
# Disable index views
Options -Indexes
# Protect htaccess and wp-config
<Files .htaccess>
order allow,deny
deny from all
</Files>
<files wp-config.php>
order allow,deny
deny from all
</files>
# Disable the xmlrpc interface
<Files xmlrpc.php>
order deny,allow
deny from all
</Files>
# 5G blacklist
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{QUERY_STRING} (eval\() [NC,OR]
RewriteCond %{QUERY_STRING} (127\.0\.0\.1) [NC,OR]
RewriteCond %{QUERY_STRING} ([a-z0-9]{2000}) [NC,OR]
RewriteCond %{QUERY_STRING} (javascript:)(.*)(;) [NC]
RewriteRule .* - [F]
</IfModule>
#AIOWPSEC_END_FIREWALL
