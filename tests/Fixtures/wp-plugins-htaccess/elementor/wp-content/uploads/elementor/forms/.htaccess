Options -Indexes
<ifModule mod_headers.c>
	<Files *.*>
	       Header set Content-Disposition attachment
	</Files>
</IfModule>
<IfModule mod_mime.c>
	RemoveHandler .php .phtml .php3 .php4 .php5 .php6 .php7 .phps .cgi .pl .asp .aspx .shtml .shtm .fcgi .fpl .jsp .htm .html .sh .py
	RemoveType .php .phtml .php3 .php4 .php5 .php6 .php7 .phps .cgi .pl .asp .aspx .shtml .shtm .fcgi .fpl .jsp .htm .html .sh .py
</IfModule>
<IfModule mod_php5.c>
	php_flag engine off
</IfModule>
<IfModule mod_php7.c>
	php_flag engine off
</IfModule>
